---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Hero from "../../components/pr/Hero.astro";
import Section from "../../components/pr/Section.astro";
import Photo from "../../components/pr/Photo.astro";
import Faq from "../../components/pr/Faq.astro";
import TeamCards from "../../components/pr/TeamCards.astro";
import Band from "../../components/pr/Band.astro";
import LinkList from "../../components/pr/LinkList.astro";
import procedures from "../../data/procedures.json";
import { sitePhotos } from "../../data/sitePhotos";
import { procedureLinks, procedureTitles } from "../../data/procedureMeta";
import { breadcrumbSchema, medicalPageSchema } from "../../lib/schema";

// Dental implants hub. Hand-built layout; the wording is the practice's
// existing page copy from procedures.json.
const slug = "replacing-missing-teeth";
const page = procedures[slug];
const faqSource = procedures["dental-implants-faq"];
const path = `/services/${slug}/`;
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Procedures", href: "/#procedures" },
  { name: "Replacing missing teeth" },
];

const optionType: Record<string, string> = {
  "Fixed bridge": "Fixed",
  Flipper: "Removable",
  "Metal partial": "Removable",
  Denture: "Removable",
};
const options = page.cards.items.filter((item) => item.title !== "Dental implants");
const implants = page.cards.items.find((item) => item.title === "Dental implants")!;

const implantPages = ["single-tooth-implant", "full-mouth-dental-implants", "immediate-implants", "implant-dentures", "zygomatic-implants", "bone-grafting-for-implants"];
const explore = implantPages.map((other) => ({ title: procedureLinks[other].name, text: procedureLinks[other].line, href: `/services/${other}/` }));
const planning = ["after-implant-placement", "cost-of-dental-implants", "dental-implants-faq"];

// Answers come from the existing Dental Implants FAQ page.
const timing = faqSource.panel.chips;
const downside = faqSource.pair[0];
const faq = [
  ...faqSource.cards.items.map((item) => ({ q: item.title, a: item.body.join(" ") })),
  { q: "How long does treatment take?", a: `${timing[0]}. ${timing[1]}. ${timing[2]}. ${timing[3]}.` },
  { q: downside.h2, a: downside.paragraphs.join(" ") },
];

const schema = [
  breadcrumbSchema(crumbs.map((crumb, index) => (index === crumbs.length - 1 ? { ...crumb, href: path } : crumb))),
  medicalPageSchema({ path, name: "Replacing missing teeth with dental implants", description: page.description, procedure: "Dental implants" }),
];
---

<Layout title={procedureTitles[slug]} description={page.description} schema={schema}>
  <Header />
  <main id="main-content" tabindex="-1" class="pr-main">
    <Hero
      crumbs={crumbs}
      eyebrow={page.hero.eyebrow}
      title="Replacing <span>missing teeth.</span>"
      lede={page.hero.lede}
      photo={sitePhotos.welcomeConversation}
    />

    <Section tone="cream" label="Overview" id="overview">
      <div class="pr-why">
        <div data-rv>
          <p class="pr-eb">{page.intro.eyebrow}</p>
          <h2 class="pr-h2"><span>Missing teeth affect</span><br />more than appearance.</h2>
          {page.intro.paragraphs.map((paragraph) => <p class="pr-p">{paragraph}</p>)}
          {page.intro.note && <div class="pr-note"><b>{page.intro.note.label}</b><span>{page.intro.note.text}</span></div>}
        </div>
        <Photo photo={sitePhotos.teamWithPatient} reveal="right" />
      </div>
    </Section>

    <Section tone="sand" label="Tooth replacement options">
      <p class="pr-eb" data-rv>{page.cards.eyebrow}</p>
      <h2 class="pr-h2" data-rv><span>Compare temporary, removable,</span><br />and long-lasting solutions.</h2>
      {page.cards.sub.map((paragraph) => <p class="pr-p pr-sub" data-rv>{paragraph}</p>)}
      <div class="pr-rows" data-rv>
        {options.map((item) => (
          <div>
            <h3>{item.title}</h3>
            <div>{item.body.map((paragraph) => <p>{paragraph}</p>)}</div>
            <small>{optionType[item.title]}</small>
          </div>
        ))}
        <a class="pr-row-imp" href="#implant-types">
          <h3>{implants.title}</h3>
          <div>{implants.body.map((paragraph) => <p>{paragraph}</p>)}</div>
          <small>Fixed · See implant types ↓</small>
        </a>
      </div>
    </Section>

    <Section tone="cream" label="Types of dental implants" id="implant-types">
      <p class="pr-eb" data-rv>Types of dental implants</p>
      <h2 class="pr-h2" data-rv><span>Which implant</span><br />is right for you?</h2>
      <div class="pr-ex">
        <Photo photo={sitePhotos.brightRoom} left reveal="left" />
        <div>
          <LinkList items={explore} />
          <p class="pr-hero-note">
            Planning ahead: {planning.map((other, index) => (
              <Fragment>{index > 0 && " · "}<a href={`/services/${other}/`}>{procedureLinks[other].name}</a></Fragment>
            ))}
          </p>
        </div>
      </div>
    </Section>

    <Section tone="sand" label={page.panel.eyebrow}>
      <div class="pr-why">
        <Photo photo={sitePhotos.surgicalChair} left reveal="left" />
        <div data-rv>
          <p class="pr-eb">{page.panel.eyebrow}</p>
          <h2 class="pr-h2"><span>Stable replacement</span><br />without compromising healthy teeth.</h2>
          {page.panel.paragraphs.map((paragraph) => <p class="pr-p">{paragraph}</p>)}
          <ul class="pr-checks">
            {page.panel.chips.map((chip) => (
              <li><span class="pr-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4 10-10" /></svg></span>{chip}</li>
            ))}
          </ul>
        </div>
      </div>
    </Section>

    <Section tone="cream" label="Your surgical team">
      <TeamCards heading="<span>Planned and placed</span><br>by our surgeons." imagingNote="Detailed 3D views for implant planning" />
    </Section>

    <Section tone="sand" label="Frequently asked questions" wrapClass="pr-faqwrap">
      <div data-rv>
        <p class="pr-eb">Patient questions</p>
        <h2 class="pr-h2 sm"><span>Questions patients</span><br />ask most.</h2>
        <p class="pr-p">{faqSource.pair[1].paragraphs[0]}</p>
        <a class="pr-link" style="margin-top:24px" href="/services/dental-implants-faq/">All implant questions →</a>
      </div>
      <Faq items={faq} />
    </Section>

    <Band tone="sand" eyebrow={page.cta.eyebrow} heading="<span>Start with</span><br>a consultation." text={page.cta.paragraphs.join(" ")} />
  </main>
  <SiteFooter />
</Layout>
