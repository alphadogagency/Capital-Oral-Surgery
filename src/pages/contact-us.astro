---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AppointmentRequestForm from "../components/AppointmentRequestForm.astro";
import Hero from "../components/pr/Hero.astro";
import Section from "../components/pr/Section.astro";
import Photo from "../components/pr/Photo.astro";
import LinkList from "../components/pr/LinkList.astro";
import { sitePhotos } from "../data/sitePhotos";
import { breadcrumbSchema } from "../lib/schema";
import { OFFICE_PHONE, PRACTICE, SERVICE_AREA_LINE } from "../lib/site";

const title = "Contact Us | Capital Oral Surgery, Topeka, KS";
const description =
  "Contact Capital Oral Surgery and Dental Implants in Topeka, KS. Request an appointment, call the office, or find directions to 2445 SW Wanamaker Rd, Suite 101.";
const path = "/contact-us/";
const crumbs = [{ name: "Home", href: "/" }, { name: "Contact us" }];
const next = [
  { title: "Your first visit", text: "What to bring and what to expect at your consultation.", href: "/first-visit/" },
  { title: "Payment plans", text: "Insurance, monthly financing with Cherry and in-office options.", href: "/payment-plans/" },
  { title: "Surgical instructions", text: "Before and after care for sedation, implants, wisdom teeth and extractions.", href: "/surgical-instructions/" },
  { title: "Referring doctors", text: "Send a referral online or call our office.", href: "/refer-a-patient/" },
];
const schema = [breadcrumbSchema([{ name: "Home", href: "/" }, { name: "Contact us", href: path }])];
---

<Layout title={title} description={description} schema={schema}>
  <Header />
  <main id="main-content" tabindex="-1" class="pr-main">
    <Hero
      crumbs={crumbs}
      eyebrow="Contact us"
      title="Contact <span>our office.</span>"
      lede="There are many ways to communicate with our office. Choose the method most convenient for you, or send a request and our team will help you plan the right visit."
      photo={sitePhotos.entrance}
      primary={{ label: "Send a request ↓", href: "#contact-form" }}
    />

    <Section tone="cream" label="Ways to reach us" id="reach-us">
      <div class="ct-reach">
        <div data-rv>
          <span class="pr-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg></span>
          <small>Call</small>
          <h2><a href={OFFICE_PHONE.href}>{OFFICE_PHONE.display}</a></h2>
          <p>Speak with our Topeka office team about scheduling, referrals, and visit details.</p>
          <a class="pr-link" href={OFFICE_PHONE.href}>Call the office →</a>
        </div>
        <div data-rv style="--rv-delay:80ms">
          <span class="pr-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg></span>
          <small>Visit</small>
          <h2>{PRACTICE.street}<br />{PRACTICE.city}, {PRACTICE.region} {PRACTICE.postalCode}</h2>
          <p>Find us near SW Wanamaker Road in Topeka, Kansas 66614.</p>
          <a class="pr-link" href={PRACTICE.mapsUrl} target="_blank" rel="noopener noreferrer">Get directions →</a>
        </div>
        <div data-rv style="--rv-delay:160ms">
          <span class="pr-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>
          <small>Hours</small>
          <h2>{PRACTICE.hoursDays}<br />{PRACTICE.hoursTime}</h2>
          <p>Send a request anytime and our team will follow up during office hours.</p>
          <a class="pr-link" href="#contact-form">Send a request ↓</a>
        </div>
      </div>
    </Section>

    <Section tone="sand" label="Request an appointment" id="contact-form" wrapClass="ct-form">
      <div>
        <p class="pr-eb">Request appointment</p>
        <h2 class="pr-h2 sm"><span>Tell us</span> how we can help.</h2>
        <p class="pr-p">Share a few details and our team will reach out to confirm next steps. This is an appointment request, not a confirmed booking. Please avoid sending sensitive medical information through this form.</p>
        <ol class="ct-next">
          <li><div><b>We review your request</b><span>Our team follows up during office hours.</span></div></li>
          <li><div><b>We contact you</b><span>To confirm next steps.</span></div></li>
          <li><div><b>Your appointment is confirmed</b><span>After our team contacts you.</span></div></li>
        </ol>
        <dl class="ct-facts">
          <div><dt>Mailing address</dt><dd>{PRACTICE.street}, {PRACTICE.city}, {PRACTICE.region} {PRACTICE.postalCode}</dd></div>
          <div><dt>Telephone</dt><dd><a href={OFFICE_PHONE.href}>{OFFICE_PHONE.display}</a></dd></div>
          <div><dt>Serving</dt><dd>{SERVICE_AREA_LINE.replace("Serving ", "")}</dd></div>
        </dl>
      </div>
      <div class="ct-card">
        <AppointmentRequestForm />
      </div>
    </Section>

    <Section tone="cream" label="Find us" id="directions" wrapClass="ct-map">
      <div data-rv>
        <p class="pr-eb">Online map &amp; driving directions</p>
        <h2 class="pr-h2 sm"><span>Plan your visit</span> to our Topeka office.</h2>
        <p class="pr-p">If this is your first time visiting, use the map link for directions, travel time, and distance. For any additional information, call us at <a href={OFFICE_PHONE.href}>{OFFICE_PHONE.display}</a>.</p>
        <a class="pr-link" style="margin-top:24px" href={PRACTICE.mapsUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps →</a>
      </div>
      <iframe src={PRACTICE.mapsEmbed} title="Map to Capital Oral Surgery and Dental Implants in Topeka" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" data-rv="right"></iframe>
    </Section>

    <Section tone="sand" label="Before your visit">
      <p class="pr-eb" data-rv>Before your visit</p>
      <h2 class="pr-h2" data-rv><span>Helpful</span><br />next steps.</h2>
      <div class="pr-ex">
        <Photo photo={sitePhotos.frontDesk} left reveal="left" />
        <LinkList items={next} />
      </div>
    </Section>
  </main>
  <SiteFooter />
</Layout>
