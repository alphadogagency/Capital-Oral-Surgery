---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Hero from "../../components/pr/Hero.astro";
import ReferralRequestForm from "../../components/ReferralRequestForm.astro";
import { sitePhotos } from "../../data/sitePhotos";
import { breadcrumbSchema } from "../../lib/schema";
import { OFFICE_PHONE } from "../../lib/site";

const title = "Patient Referral Form | Capital Oral Surgery, Topeka, KS";
const description =
  "Submit a secure patient referral to Capital Oral Surgery and Dental Implants in Topeka, KS.";
const crumbs = [{ name: "Home", href: "/" }, { name: "Referring doctors", href: "/refer-a-patient/" }, { name: "Referral form" }];
const schema = [breadcrumbSchema([...crumbs.slice(0, 2), { name: "Referral form", href: "/refer-a-patient/form/" }])];
---

<Layout title={title} description={description} schema={schema}>
  <Header />
  <main id="main-content" tabindex="-1" class="pr-main">
    <Hero
      crumbs={crumbs}
      eyebrow="For referring offices"
      title="Refer <span>a patient.</span>"
      lede="Complete the form below to share a patient referral with our office. Patient data security and privacy are primary concerns throughout this process."
      photo={sitePhotos.coordinator}
      primary={{ label: "Start the form ↓", href: "#referral-form" }}
    >
      <p class="pr-hero-note">* Required fields</p>
    </Hero>

    <section class="pr-sec pr-cream" aria-label="Referral form" id="referral-form">
      <div class="pr-wrap" style="max-width:1000px">
        <div class="ct-card">
          <ReferralRequestForm />
        </div>
        <p class="pr-hero-note" style="text-align:center">Prefer to call? Reach our office at <a href={OFFICE_PHONE.href}>{OFFICE_PHONE.display}</a>.</p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
