---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ToggleGroup from "../../components/referral/ToggleGroup.astro";
import ToothChart from "../../components/referral/ToothChart.astro";
import { OFFICE_PHONE } from "../../lib/site";

const title =
  "Referral Form | Capital Oral Surgery and Dental Implants, Topeka KS";
const description =
  "Submit a secure patient referral to Capital Oral Surgery and Dental Implants in Topeka, KS.";

const inputClass =
  "mt-2 h-12 w-full rounded-md border border-line bg-surface px-4 text-sm text-foreground placeholder:text-placeholder focus:border-secondary focus:outline-none focus:ring-2 focus:ring-secondary/20";
const textareaClass =
  "mt-2 min-h-[112px] w-full resize-y rounded-md border border-line bg-surface px-4 py-3 text-sm text-foreground placeholder:text-placeholder focus:border-secondary focus:outline-none focus:ring-2 focus:ring-secondary/20";

const procedures = [
  ["procedureExtractions", "Extractions (see below)"],
  ["procedureAlveoplasty", "Alveoplasty"],
  ["procedureBiopsy", "Biopsy"],
  ["procedureIncisionDrainage", "Incision & Drainage"],
  ["procedureLesionEvaluation", "Lesion Evaluation"],
  ["procedureExposure", "Exposure"],
  ["procedureHardTissue", "Hard Tissue"],
  ["procedureInfection", "Infection"],
  ["procedureExposeBond", "Expose & Bond"],
  ["procedureSoftTissue", "Soft Tissue"],
  ["procedureFrenectomy", "Frenectomy"],
  ["procedureApicoectomy", "Apicoectomy"],
  ["procedureOther", "Other"],
];

const consultations = [
  ["consultationTmj", "TMJ"],
  ["consultationImplants", "Implants"],
  ["consultationOrthognathic", "Orthognathic Evaluation"],
  ["consultationPreProsthetic", "Pre-Prosthetic"],
  ["consultationCleftLipPalate", "Cleft Lip & Palate"],
  ["consultationCosmetic", "Cosmetic"],
  ["consultationRidgeAugmentation", "Ridge Augmentation"],
  ["consultationOralFacialLesion", "Oral / Facial Lesion"],
  ["consultationBoneGrafting", "Bone Grafting"],
  ["consultationOther", "Other"],
];

const adultUpper = Array.from({ length: 16 }, (_, index) => String(index + 1));
const adultLower = Array.from({ length: 16 }, (_, index) => String(32 - index));
const primaryUpper = ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J"];
const primaryLower = ["T", "S", "R", "Q", "P", "O", "N", "M", "L", "K"];
const radiographOptions = [
  "Being Mailed",
  "Given to Patient",
  "Please Take",
  "No X-Ray",
  "Attached with This Referral",
];
---

<Layout title={title} description={description} ogImage="/og.png">
  <Header />
  <main>
    <section class="bg-midnight px-5 py-16 text-surface lg:py-20" aria-labelledby="form-heading">
      <div class="mx-auto max-w-7xl">
        <a
          href="/refer-a-patient/"
          class="inline-flex text-sm font-bold text-accent transition-colors hover:text-surface"
        >
          ← Referring Doctors
        </a>
        <p class="mt-10 text-xs font-bold tracking-[.34em] text-secondary">
          Patient Resources
        </p>
        <h1
          id="form-heading"
          class="serif mt-5 max-w-[850px] text-5xl leading-[0.96] text-surface sm:text-6xl lg:text-[72px]"
        >
          Refer a Patient
        </h1>
        <p class="mt-7 max-w-[720px] text-lg leading-8 text-surface/75 sm:text-xl">
          Complete the form below to share a patient referral with our office. Patient
          data security and privacy are primary concerns throughout this process.
        </p>
        <p class="mt-4 text-sm font-bold text-accent">* Required fields</p>
      </div>
    </section>

    <section class="bg-background px-5 py-16 text-foreground lg:py-24">
      <div class="mx-auto max-w-[1160px]">
        <form
          id="referral-form"
          action="/api/referral"
          method="post"
          enctype="multipart/form-data"
        >
          <div class="absolute left-[-10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
            <label for="referral-website">Website</label>
            <input
              id="referral-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <section aria-labelledby="demographic-heading">
            <p class="text-xs font-bold tracking-[.34em] text-secondary">Section 1</p>
            <h2 id="demographic-heading" class="serif mt-4 text-4xl leading-tight sm:text-5xl">
              Demographic Information
            </h2>

            <div class="mt-10 rounded-lg border border-line bg-surface p-6 shadow-sm sm:p-8">
              <h3 class="serif text-3xl font-bold text-foreground">Patient Information</h3>

              <div class="mt-8">
                <p class="text-sm font-bold text-foreground">Name *</p>
                <div class="mt-3 grid gap-4 sm:grid-cols-2">
                  <div>
                    <label class="text-sm font-bold text-foreground" for="patient-first-name">
                      First Name
                    </label>
                    <input
                      id="patient-first-name"
                      name="patientFirstName"
                      type="text"
                      autocomplete="given-name"
                      required
                      class={inputClass}
                    />
                  </div>
                  <div>
                    <label class="text-sm font-bold text-foreground" for="patient-last-name">
                      Last Name
                    </label>
                    <input
                      id="patient-last-name"
                      name="patientLastName"
                      type="text"
                      autocomplete="family-name"
                      required
                      class={inputClass}
                    />
                  </div>
                </div>
              </div>

              <div class="mt-6 max-w-sm">
                <label class="text-sm font-bold text-foreground" for="patient-date-of-birth">
                  Date of Birth
                </label>
                <input
                  id="patient-date-of-birth"
                  name="patientDateOfBirth"
                  type="date"
                  autocomplete="bday"
                  class={inputClass}
                />
              </div>

              <div class="mt-8 border-t border-line pt-8">
                <p class="text-sm font-bold text-foreground">Parent / Guardian</p>
                <div class="mt-3 grid gap-4 sm:grid-cols-2">
                  <div>
                    <label class="text-sm font-bold text-foreground" for="responsible-first-name">
                      Responsible Party First Name
                    </label>
                    <input
                      id="responsible-first-name"
                      name="responsiblePartyFirstName"
                      type="text"
                      class={inputClass}
                    />
                  </div>
                  <div>
                    <label class="text-sm font-bold text-foreground" for="responsible-last-name">
                      Responsible Party Last Name
                    </label>
                    <input
                      id="responsible-last-name"
                      name="responsiblePartyLastName"
                      type="text"
                      class={inputClass}
                    />
                  </div>
                </div>
              </div>

              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div>
                  <label class="text-sm font-bold text-foreground" for="patient-telephone">
                    Contact Telephone
                  </label>
                  <input
                    id="patient-telephone"
                    name="patientTelephone"
                    type="tel"
                    autocomplete="tel"
                    class={inputClass}
                  />
                </div>
                <div>
                  <label class="text-sm font-bold text-foreground" for="patient-email">
                    Contact Email Address
                  </label>
                  <input
                    id="patient-email"
                    name="patientEmail"
                    type="email"
                    autocomplete="email"
                    class={inputClass}
                  />
                </div>
              </div>

              <div class="mt-8 grid gap-6 md:grid-cols-2">
                <ToggleGroup
                  name="antibioticsPriorToTreatment"
                  label="Does the patient require antibiotics prior to dental treatment?"
                />
                <ToggleGroup name="pleaseCallPatient" label="Please call patient" />
              </div>

              <div class="mt-6">
                <label class="text-sm font-bold text-foreground" for="treatment">
                  Treatment
                </label>
                <input id="treatment" name="treatment" type="text" class={inputClass} />
              </div>
            </div>
          </section>

          <section class="mt-20 lg:mt-24" aria-labelledby="referring-information-heading">
            <p class="text-xs font-bold tracking-[.34em] text-secondary">Section 2</p>
            <h2
              id="referring-information-heading"
              class="serif mt-4 text-4xl leading-tight sm:text-5xl"
            >
              Referring Information
            </h2>

            <div class="mt-10 rounded-lg border border-line bg-surface p-6 shadow-sm sm:p-8">
              <h3 class="serif text-3xl font-bold text-foreground">
                Referring Doctor Information
              </h3>

              <div class="mt-8">
                <p class="text-sm font-bold text-foreground">Referred By *</p>
                <div class="mt-3 grid gap-4 sm:grid-cols-2">
                  <div>
                    <label class="text-sm font-bold text-foreground" for="doctor-first-name">
                      First Name
                    </label>
                    <input
                      id="doctor-first-name"
                      name="referringDoctorFirstName"
                      type="text"
                      autocomplete="given-name"
                      required
                      class={inputClass}
                    />
                  </div>
                  <div>
                    <label class="text-sm font-bold text-foreground" for="doctor-last-name">
                      Last Name
                    </label>
                    <input
                      id="doctor-last-name"
                      name="referringDoctorLastName"
                      type="text"
                      autocomplete="family-name"
                      required
                      class={inputClass}
                    />
                  </div>
                </div>
              </div>

              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div>
                  <label class="text-sm font-bold text-foreground" for="doctor-telephone">
                    Telephone *
                  </label>
                  <input
                    id="doctor-telephone"
                    name="referringDoctorTelephone"
                    type="tel"
                    autocomplete="tel"
                    required
                    class={inputClass}
                  />
                </div>
                <div>
                  <label class="text-sm font-bold text-foreground" for="doctor-email">
                    Email Address
                  </label>
                  <input
                    id="doctor-email"
                    name="referringDoctorEmail"
                    type="email"
                    autocomplete="email"
                    class={inputClass}
                  />
                </div>
              </div>
            </div>

            <div class="mt-6 grid items-start gap-6 lg:grid-cols-2">
              <div class="rounded-lg border border-line bg-surface p-6 shadow-sm sm:p-8">
                <h3 class="serif text-3xl font-bold text-foreground">Procedures</h3>
                <div class="mt-8 grid gap-6">
                  {
                    procedures.map(([name, label]) => (
                      <div class="grid gap-4">
                        <ToggleGroup name={name} label={label} />
                        {name === "procedureOther" && (
                          <div>
                            <label
                              class="text-sm font-bold text-foreground"
                              for="procedure-other-specify"
                            >
                              Please Specify
                            </label>
                            <textarea
                              id="procedure-other-specify"
                              name="procedureOtherSpecify"
                              class={textareaClass}
                            />
                          </div>
                        )}
                      </div>
                    ))
                  }
                </div>
              </div>

              <div class="rounded-lg border border-line bg-surface p-6 shadow-sm sm:p-8">
                <h3 class="serif text-3xl font-bold text-foreground">Consultations</h3>
                <div class="mt-8 grid gap-6">
                  {
                    consultations.map(([name, label]) => (
                      <div class="grid gap-4">
                        <ToggleGroup name={name} label={label} />
                        {name === "consultationImplants" && (
                          <div class="rounded-md bg-aqua-soft p-4">
                            <ToggleGroup
                              name="consultationImplantTiming"
                              label="Implant Timing"
                              options={["Immediate", "Delayed"]}
                            />
                          </div>
                        )}
                        {name === "consultationOther" && (
                          <div>
                            <label
                              class="text-sm font-bold text-foreground"
                              for="consultation-other-specify"
                            >
                              Please Specify
                            </label>
                            <textarea
                              id="consultation-other-specify"
                              name="consultationOtherSpecify"
                              class={textareaClass}
                            />
                          </div>
                        )}
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>

            <div class="mt-6 rounded-lg border border-line bg-surface p-6 shadow-sm sm:p-8">
              <h3 class="serif text-3xl font-bold text-foreground">Implants</h3>
              <div class="mt-8 grid gap-4 md:grid-cols-2">
                <div>
                  <label class="text-sm font-bold text-foreground" for="implant-selection">
                    Implants
                  </label>
                  <select id="implant-selection" name="implantSelection" class={inputClass}>
                    <option value="">[FILL IN]</option>
                  </select>
                </div>
                <div>
                  <label class="text-sm font-bold text-foreground" for="surgical-template-selection">
                    Surgical Template
                  </label>
                  <select
                    id="surgical-template-selection"
                    name="surgicalTemplateSelection"
                    class={inputClass}
                  >
                    <option value="">[FILL IN]</option>
                  </select>
                </div>
              </div>
            </div>
          </section>

          <section class="mt-20 lg:mt-24" aria-labelledby="extraction-information-heading">
            <p class="text-xs font-bold tracking-[.34em] text-secondary">Section 3</p>
            <h2
              id="extraction-information-heading"
              class="serif mt-4 text-4xl leading-tight sm:text-5xl"
            >
              Extraction Information
            </h2>

            <div class="mt-10 rounded-lg border border-line bg-surface p-6 shadow-sm sm:p-8">
              <h3 class="serif text-3xl font-bold text-foreground">Areas of Concern</h3>
              <div class="mt-8 grid gap-10">
                <ToothChart
                  id="adult-teeth"
                  title="Adult Tooth Chart"
                  upper={adultUpper}
                  lower={adultLower}
                  minWidth="58rem"
                />
                <ToothChart
                  id="primary-teeth"
                  title="Primary Tooth Chart"
                  upper={primaryUpper}
                  lower={primaryLower}
                  minWidth="42rem"
                />
              </div>

              <div class="mt-8 border-t border-line pt-8">
                <label class="text-sm font-bold text-foreground" for="verified-extraction-teeth">
                  Please Verify Teeth for Extraction
                </label>
                <input
                  id="verified-extraction-teeth"
                  name="verifiedExtractionTeeth"
                  type="text"
                  class={inputClass}
                />
              </div>
            </div>

            <div class="mt-6 rounded-lg border border-line bg-surface p-6 shadow-sm sm:p-8">
              <h3 class="serif text-3xl font-bold text-foreground">
                Radiographs or Clinical Photos
              </h3>
              <div class="mt-8">
                <ToggleGroup
                  name="radiographDisposition"
                  label="Radiographs or Clinical Photos"
                  options={radiographOptions}
                  variant="wrap"
                />
              </div>

              <div id="radiograph-attachments" class="mt-6 rounded-md bg-aqua-soft p-5" hidden>
                <label class="text-sm font-bold text-foreground" for="radiograph-files">
                  Attach Radiographs or Clinical Photos
                </label>
                <input
                  id="radiograph-files"
                  type="file"
                  accept=".jpg,.png,.pdf"
                  multiple
                  class="mt-3 block w-full rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted file:mr-4 file:rounded-md file:border-0 file:bg-midnight file:px-4 file:py-2 file:font-bold file:text-surface"
                />
                <p class="mt-3 text-sm leading-6 text-muted">
                  Attachments remain on this device for now and are not uploaded with
                  this temporary form.
                </p>
              </div>

              <div class="mt-6">
                <label class="text-sm font-bold text-foreground" for="radiograph-date">
                  If X-Rays are attached...
                </label>
                <input
                  id="radiograph-date"
                  name="radiographDate"
                  type="text"
                  placeholder="What date were they taken?"
                  class={inputClass}
                />
              </div>
            </div>
          </section>

          <section class="mt-20 lg:mt-24" aria-labelledby="case-notes-heading">
            <p class="text-xs font-bold tracking-[.34em] text-secondary">Section 4</p>
            <div class="mt-4 rounded-lg border border-line bg-surface p-6 shadow-sm sm:p-8">
              <h2 id="case-notes-heading" class="serif text-4xl leading-tight sm:text-5xl">
                Case Notes
              </h2>
              <div class="mt-8">
                <label class="sr-only" for="case-notes">Case Notes</label>
                <textarea
                  id="case-notes"
                  name="caseNotes"
                  placeholder="Comments"
                  class={`${textareaClass} min-h-[180px]`}
                ></textarea>
              </div>
            </div>
          </section>

          <p id="referral-error" class="mt-8 text-center text-sm font-bold text-red-700" role="alert" hidden>
            We could not submit the referral. Please try again or call {OFFICE_PHONE.display}.
          </p>

          <button
            id="referral-submit"
            type="submit"
            class="mt-8 h-14 w-full rounded-md bg-secondary px-6 text-base font-bold text-surface transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/40 focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-60"
          >
            Complete and Send
          </button>
        </form>

        <div
          id="referral-success"
          class="rounded-lg border border-secondary/30 bg-surface p-8 text-center shadow-sm sm:p-12"
          role="status"
          aria-live="polite"
          tabindex="-1"
          hidden
        >
          <p class="text-xs font-bold tracking-[.34em] text-secondary">Referral received</p>
          <h2 class="serif mx-auto mt-4 max-w-3xl text-4xl leading-tight sm:text-5xl">
            Thank you — your referral has been received. Our office will contact you
            shortly.
          </h2>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    const referralForm = document.querySelector<HTMLFormElement>("#referral-form");
    const verifiedTeethInput = document.querySelector<HTMLInputElement>(
      "#verified-extraction-teeth",
    );
    const toothToggles = Array.from(
      document.querySelectorAll<HTMLInputElement>("[data-tooth-toggle]"),
    );
    const radiographChoices = Array.from(
      document.querySelectorAll<HTMLInputElement>(
        'input[name="radiographDisposition"]',
      ),
    );
    const attachmentPanel = document.querySelector<HTMLElement>(
      "#radiograph-attachments",
    );
    const attachmentInput = document.querySelector<HTMLInputElement>(
      "#radiograph-files",
    );
    const successPanel = document.querySelector<HTMLElement>("#referral-success");
    const errorMessage = document.querySelector<HTMLElement>("#referral-error");
    const submitButton = document.querySelector<HTMLButtonElement>("#referral-submit");

    const updateVerifiedTeeth = () => {
      if (!verifiedTeethInput) return;

      verifiedTeethInput.value = toothToggles
        .filter((tooth) => tooth.checked)
        .map((tooth) => tooth.value)
        .join(", ");
    };

    toothToggles.forEach((tooth) => {
      tooth.addEventListener("change", updateVerifiedTeeth);
    });

    radiographChoices.forEach((choice) => {
      choice.addEventListener("change", () => {
        if (!attachmentPanel) return;

        const shouldShow = choice.checked && choice.value === "Attached with This Referral";
        attachmentPanel.hidden = !shouldShow;

        if (!shouldShow && attachmentInput) {
          attachmentInput.value = "";
        }
      });
    });

    const showSuccess = () => {
      if (!referralForm || !successPanel) return;

      referralForm.hidden = true;
      successPanel.hidden = false;
      successPanel.focus();
    };

    referralForm?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!referralForm.reportValidity()) return;

      if (errorMessage) errorMessage.hidden = true;

      const honeypot = referralForm.elements.namedItem("website");
      if (honeypot instanceof HTMLInputElement && honeypot.value.trim()) {
        showSuccess();
        return;
      }

      const formData = new FormData(referralForm);

      // TODO: Include radiograph attachments when Resend delivery is wired.
      // The file input intentionally has no name, so files remain client-side only.

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "Sending...";
      }

      try {
        const response = await fetch(referralForm.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (!response.ok) throw new Error("Referral request failed");

        showSuccess();
      } catch {
        if (errorMessage) errorMessage.hidden = false;
      } finally {
        if (submitButton && !referralForm.hidden) {
          submitButton.disabled = false;
          submitButton.textContent = "Complete and Send";
        }
      }
    });
  </script>
</Layout>
