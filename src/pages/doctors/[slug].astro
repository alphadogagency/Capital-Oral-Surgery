---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Hero from "../../components/pr/Hero.astro";
import Section from "../../components/pr/Section.astro";
import LinkList from "../../components/pr/LinkList.astro";
import { doctors, type Doctor } from "../../data/doctors";
import { doctorProfiles, practiceProcedures } from "../../data/doctorProfiles";
import { sitePhotos } from "../../data/sitePhotos";
import { splitHeading } from "../../lib/headings";
import { breadcrumbSchema, PRACTICE_ID } from "../../lib/schema";
import { OFFICE_PHONE, absoluteUrl } from "../../lib/site";

export function getStaticPaths() {
  return doctors.map((doctor) => ({ params: { slug: doctor.slug }, props: { doctor } }));
}

interface Props { doctor: Doctor }
const { doctor } = Astro.props;
const profile = doctorProfiles[doctor.slug];
const other = doctors.find((entry) => entry.slug !== doctor.slug)!;
const isLucaci = doctor.slug === "patrick-lucaci";
const { background, expertise, affiliations, recognition } = doctor.sections;
const path = `/doctors/${doctor.slug}/`;
const title = `${doctor.name}, ${doctor.credentials} | Oral Surgeon in Topeka, KS`;
const description = `Meet ${doctor.name}, ${doctor.credentials}, an oral and maxillofacial surgeon at Capital Oral Surgery & Dental Implants in Topeka, KS. Call ${OFFICE_PHONE.display}.`;
const crumbs = [{ name: "Home", href: "/" }, { name: "Doctors", href: "/#team" }, { name: doctor.name }];

// Dr. Lucaci: memberships and lectures. Dr. Lonergan: board certification,
// memberships and teaching. All items are from the existing biographies.
const memberships = isLucaci
  ? recognition.lists[0].items
  : ["Diplomate, American Board of Oral and Maxillofacial Surgery", ...recognition.lists[0].items];
const sideList = isLucaci ? recognition.lists[1] : affiliations.lists[0];
const personal = isLucaci ? undefined : recognition.lists[1].items[0];
const careCard = isLucaci ? expertise.cards[1] : undefined;
const treats = [...practiceProcedures, ...(isLucaci ? [{ title: "Reconstructive oral surgery", text: "", href: "" }] : [])];
const icon = (text: string) =>
  /^Recipient/.test(text) ? "award" : isLucaci ? "talk" : "teach";

const schema = [
  breadcrumbSchema(crumbs.map((crumb, index) => (index === crumbs.length - 1 ? { ...crumb, href: path } : crumb))),
  {
    "@type": "ProfilePage",
    "@id": `${absoluteUrl(path)}#webpage`,
    url: absoluteUrl(path),
    name: title,
    mainEntity: {
      "@type": "Person",
      "@id": `${absoluteUrl(path)}#person`,
      name: doctor.name.replace(/^Dr\.\s*/, ""),
      honorificPrefix: "Dr.",
      honorificSuffix: doctor.credentials,
      jobTitle: "Oral and maxillofacial surgeon",
      description: doctor.heroLead,
      image: absoluteUrl(doctor.image),
      url: absoluteUrl(path),
      worksFor: { "@id": PRACTICE_ID },
      hasCredential: profile.credentials.map((name) => ({ "@type": "EducationalOccupationalCredential", name })),
      alumniOf: profile.alumniOf.map((name) => ({ "@type": "CollegeOrUniversity", name })),
      memberOf: recognition.lists[0].items.map((name) => ({ "@type": "Organization", name })),
    },
  },
];
---

<Layout title={title} description={description} ogImage={doctor.image} schema={schema}>
  <Header />
  <main id="main-content" tabindex="-1" class="pr-main">
    <Hero
      crumbs={crumbs}
      eyebrow="Meet the doctor"
      title={`${profile.first} <span>${profile.last}</span>`}
      lede={doctor.heroLead}
      portrait={{ src: doctor.image, alt: `${doctor.name}, oral and maxillofacial surgeon in Topeka`, width: doctor.imageWidth, height: doctor.imageHeight, position: "50% 18%" }}
    >
      <div class="pr-tags" slot="tags">{profile.tags.map((tag) => <span class="pr-tag">{tag}</span>)}</div>
      <div class="dr-facts">
        {profile.facts.map(([label, detail]) => <div><b>{label}</b><small>{detail}</small></div>)}
      </div>
    </Hero>

    <Section tone="cream" label="Background and training" id="background" wrapClass="dr-two">
      <div class="dr-story" data-rv>
        <p class="pr-eb">{background.eyebrow}</p>
        <h2 class="pr-h2" set:html={splitHeading(background.heading)} />
        {background.paragraphs.map((paragraph) => <p class="pr-p">{paragraph}</p>)}
        {personal && <p class="pr-p">{personal}</p>}
      </div>
      <div class="dr-train" data-rv="right">
        <h3>Education and training</h3>
        {isLucaci && <p class="pr-p" style="margin-bottom:24px;font-size:15px">{affiliations.intro}</p>}
        <ol class="dr-tl">
          {profile.timeline.map(([year, degree, school]) => <li><em>{year}</em><b>{degree}</b><small>{school}</small></li>)}
        </ol>
        <div class="dr-certs">
          <span>Advanced certifications</span>
          {profile.certifications.map((cert) => <span class="pr-tag">{cert}</span>)}
        </div>
      </div>
    </Section>

    {isLucaci && careCard ? (
      <Section tone="sand" label="Care and specialties">
        <div class="pr-head">
          <div data-rv>
            <p class="pr-eb">Care and specialties</p>
            <h2 class="pr-h2" set:html={splitHeading(expertise.heading)} />
          </div>
          <p class="pr-p" data-rv>{expertise.cards[0].paragraphs[0]}</p>
        </div>
        <div class="dr-care">
          <div class="dr-feat" data-rv="left">
            <div class="bg"><Image src={sitePhotos.roomWide.src} alt="" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 45vw" loading="lazy" /></div>
            <div>
              <small>How he works</small>
              <h3>{careCard.title}</h3>
              {careCard.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <div><a class="pr-btn t" href="/contact-us/#contact-form">Request a consultation →</a></div>
          </div>
          <div data-rv>
            <p class="dr-list-h">What Dr. {profile.last} treats</p>
            <p class="pr-p" style="margin-bottom:16px;font-size:15px">{expertise.cards[0].paragraphs[1]}</p>
            <LinkList items={treats.map((item) => ({ title: item.title, text: item.text || undefined, href: item.href || undefined }))} />
          </div>
        </div>
      </Section>
    ) : (
      <Section tone="sand" label="Education and training">
        <p class="pr-eb" data-rv>{expertise.eyebrow}</p>
        <h2 class="pr-h2" data-rv set:html={splitHeading(expertise.heading)} />
        <div class="pr-pair">
          {expertise.cards.map((card, index) => (
            <div data-rv style={`--rv-delay:${index * 80}ms`}>
              <h3>{card.title}</h3>
              {card.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          ))}
        </div>
        <p class="pr-cap" style="margin-top:56px" data-rv>Procedures at Capital Oral Surgery</p>
        <div style="margin-top:14px"><LinkList items={practiceProcedures} columns={2} /></div>
      </Section>
    )}

    <Section tone="cream" label={isLucaci ? "Affiliations and recognition" : "Credentials and teaching"}>
      <div class="pr-head">
        <div data-rv>
          <p class="pr-eb">{isLucaci ? "Affiliations and recognition" : "Credentials and teaching"}</p>
          <h2 class="pr-h2" set:html={splitHeading(recognition.heading)} />
        </div>
        <div data-rv>
          <p class="pr-p">{recognition.intro}</p>
          {!isLucaci && <p class="pr-p">{affiliations.intro}</p>}
        </div>
      </div>
      <div class="dr-cols">
        <div data-rv>
          <h3>{isLucaci ? "Professional memberships" : "Board certification and memberships"}</h3>
          <ul class="dr-mem">
            {memberships.map((item) => (
              <li><span class="pr-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4 10-10" /></svg></span>{item}</li>
            ))}
          </ul>
        </div>
        <div data-rv style="--rv-delay:80ms">
          <h3>{isLucaci ? sideList.title : "Teaching and curriculum"}</h3>
          <ul class="dr-rec">
            {sideList.items.map((item) => (
              <li>
                <span class="pr-ic">
                  {icon(item) === "talk" && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg>}
                  {icon(item) === "award" && <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="6" /><path d="M8.5 14 7 22l5-3 5 3-1.5-8" /></svg>}
                  {icon(item) === "teach" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5z" /><path d="M6 11v5c3 2.5 9 2.5 12 0v-5" /></svg>}
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Section>

    <section class="pr-sec pr-cream flush" aria-label="Schedule a consultation">
      <div class="pr-wrap">
        <div class="pr-band" data-rv>
          <div>
            <p class="pr-eb">Schedule a consultation</p>
            <h2 style="margin-bottom:26px"><span>Start with care</span><br />that keeps you informed.</h2>
            <div class="btns">
              <a class="pr-btn t" href="/contact-us/#contact-form">Request Appointment</a>
              <a class="pr-btn o" href={OFFICE_PHONE.href}>Call {OFFICE_PHONE.display}</a>
            </div>
          </div>
          <a class="dr-other" href={`/doctors/${other.slug}/`}>
            <img src={other.image} alt="" width={other.imageWidth} height={other.imageHeight} loading="lazy" decoding="async" />
            <span><small>Also on our team</small><b>{other.name}</b><span>{other.credentials} · View profile →</span></span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
