---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/pr/Hero.astro";
import Section from "../components/pr/Section.astro";
import Photo from "../components/pr/Photo.astro";
import Band from "../components/pr/Band.astro";
import LinkList from "../components/pr/LinkList.astro";
import groups from "../data/surgicalInstructions.json";
import { sitePhotos } from "../data/sitePhotos";
import { breadcrumbSchema } from "../lib/schema";
import { OFFICE_PHONE } from "../lib/site";

// Every instruction is the practice's existing wording (surgicalInstructions.json).
// Only the layout changes: an index, then one section per instruction set.
const title = "Surgical Instructions | Capital Oral Surgery, Topeka, KS";
const description =
  "Pre- and post-operative instructions for oral surgery patients at Capital Oral Surgery in Topeka, KS: IV sedation, dental implants, wisdom teeth and extractions.";
const path = "/surgical-instructions/";
const crumbs = [{ name: "Home", href: "/" }, { name: "Patient resources" }, { name: "Surgical instructions" }];

const shortTitle: Record<string, string> = {
  "before-anesthesia": "Before IV sedation",
  "after-dental-implant-surgery": "After dental implant surgery",
  "after-wisdom-tooth-removal": "After wisdom tooth removal",
  "after-tooth-extraction": "After tooth extraction",
};
const oneLine: Record<string, string> = {
  "before-anesthesia": "What to do before oral surgery with IV sedation.",
  "after-dental-implant-surgery": "Bleeding, swelling, diet, pain and care for the first days.",
  "after-wisdom-tooth-removal": "Recovery after wisdom teeth extraction, step by step.",
  "after-tooth-extraction": "Caring for the blood clot after a single tooth is removed.",
};
// Headings added to the extraction paragraphs so every after-care set reads the same way.
const looseHeadings: Record<string, string[]> = {
  "after-tooth-extraction": ["Bleeding", "Protecting the blood clot", "Pain and swelling", "Medication and diet", "Brushing and rinsing", "When to call us"],
};
const heading = (id: string) => {
  const words = shortTitle[id].split(" ");
  return `<span>${words[0]}</span> ${words.slice(1).join(" ")}.`;
};
const index = groups.map((group) => ({ title: shortTitle[group.id], text: oneLine[group.id], href: `#${group.id}` }));
const schema = [breadcrumbSchema([{ name: "Home", href: "/" }, { name: "Surgical instructions", href: path }])];
---

<Layout title={title} description={description} schema={schema}>
  <Header />
  <main id="main-content" tabindex="-1" class="pr-main">
    <Hero
      crumbs={crumbs}
      eyebrow="Patient resources"
      title="Surgical <span>instructions.</span>"
      lede={`Please follow these instructions carefully before and after your procedure. If you have any questions, call our office at ${OFFICE_PHONE.display}.`}
      photo={sitePhotos.welcomeConversation}
      primary={{ label: "Find your instructions ↓", href: "#instructions" }}
      secondary={{ label: `Questions? ${OFFICE_PHONE.display}`, href: OFFICE_PHONE.href }}
    />

    <Section tone="cream" label="Choose your instructions" id="instructions">
      <p class="pr-eb" data-rv>Choose your instructions</p>
      <h2 class="pr-h2" data-rv><span>Find the instructions</span><br />for your procedure.</h2>
      <div class="pr-ex">
        <Photo photo={sitePhotos.roomMonitors} left reveal="left" />
        <LinkList items={index} arrow="↓" />
      </div>
    </Section>

    {groups.map((group, groupIndex) => (
      <Section tone={groupIndex % 2 === 0 ? "sand" : "cream"} label={group.title} id={group.id} wrapClass="pr-faqwrap pr-si">
        <div>
          <p class="pr-eb">{group.eyebrow}</p>
          <h2 class="pr-h2 sm" aria-label={group.title} set:html={heading(group.id)} />
          {group.sub && <p class="pr-sm">{group.sub}</p>}
          {group.intro.map((paragraph) => <p class="pr-p" style="margin-top:12px" set:html={paragraph} />)}
          <div class="pr-note">
            <b>Something doesn't feel right?</b>
            <span>Call our office at <a href={OFFICE_PHONE.href}>{OFFICE_PHONE.display}</a>. We would rather hear from you.</span>
          </div>
          <div class="pr-si-act">
            <button type="button" class="pr-link" data-print>Print instructions</button>
            <a class="pr-link" href="#instructions">All instructions ↑</a>
          </div>
        </div>
        <div>
          {group.list.length > 0 && (
            <ul class="pr-steps">
              {group.list.map((item) => (
                <li><span class="pr-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4 10-10" /></svg></span><span set:html={item} /></li>
              ))}
            </ul>
          )}
          {group.loose.length > 0 && (
            <div class="pr-faq">
              {group.loose.map((paragraph, itemIndex) => (
                <details open={itemIndex === 0}>
                  <summary>{looseHeadings[group.id]?.[itemIndex] ?? `Part ${itemIndex + 1}`}<i aria-hidden="true"></i></summary>
                  <div class="pr-fa"><p set:html={paragraph} /></div>
                </details>
              ))}
            </div>
          )}
          {group.topics.length > 0 && (
            <div class="pr-faq">
              {group.topics.map((topic, itemIndex) => (
                <details open={itemIndex === 0}>
                  <summary>{topic.title}<i aria-hidden="true"></i></summary>
                  <div class="pr-fa" set:html={topic.html} />
                </details>
              ))}
            </div>
          )}
        </div>
      </Section>
    ))}

    <Band
      tone="cream"
      eyebrow="Patient resources"
      heading="<span>We're here</span><br>to help."
      text="If you have questions about these instructions or your procedure, call our office."
      primary={{ label: `Call ${OFFICE_PHONE.display}`, href: OFFICE_PHONE.href }}
      secondary={{ label: "Request Appointment", href: "/contact-us/#contact-form" }}
    />
  </main>
  <SiteFooter />
</Layout>

<script>
  // Printing shows every instruction: open all accordions, then restore them.
  const accordions = [...document.querySelectorAll<HTMLDetailsElement>(".pr-faq details")];
  let closed: HTMLDetailsElement[] = [];
  window.addEventListener("beforeprint", () => {
    closed = accordions.filter((item) => !item.open);
    closed.forEach((item) => (item.open = true));
  });
  window.addEventListener("afterprint", () => closed.forEach((item) => (item.open = false)));
  document.querySelectorAll("[data-print]").forEach((button) => button.addEventListener("click", () => window.print()));
</script>
