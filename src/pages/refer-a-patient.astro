---
import { Image } from "astro:assets";
import interiorHeroImage from "../../public/images/specialized-care.jpg";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { OFFICE_PHONE } from "../lib/site";

const title =
  "Referring Doctors | Capital Oral Surgery and Dental Implants, Topeka KS";
const description =
  "Refer patients to Capital Oral Surgery and Dental Implants in Topeka, KS for elective oral surgery procedures and emergency care.";
const referralFormUrl = "/refer-a-patient/form/";
---

<Layout title={title} description={description} ogImage="/og.png">
  <Header />
  <main id="main-content" tabindex="-1" class="interior-main interior-resource">
    <section class="interior-hero bg-midnight text-surface" aria-labelledby="referral-heading">
      <div
        class="interior-hero-grid mx-auto grid min-h-[calc(100dvh-76px)] max-w-7xl items-center gap-10 px-5 py-14 lg:gap-14 xl:grid-cols-[minmax(0,610px)_minmax(360px,500px)] xl:justify-between xl:px-0"
      >
        <div class="interior-hero-copy" data-reveal>
          <a
            href="/"
            class="inline-flex text-sm font-bold text-accent transition-colors hover:text-surface"
          >
            ← Home
          </a>
          <p class="mt-10 text-xs font-bold tracking-[.34em] text-secondary">
            Patient Resources
          </p>
          <h1
            id="referral-heading"
            class="serif mt-5 max-w-[760px] text-5xl leading-[0.96] text-surface sm:text-6xl xl:text-[72px]"
          >
            Referring Doctors
          </h1>
          <p class="mt-7 max-w-[590px] text-lg leading-8 text-surface/75 sm:text-xl">
            We welcome referrals from medical and dental colleagues for elective
            procedures and emergency care. Our team values close collaboration and
            timely communication with your office throughout each patient's care.
          </p>
          <div class="mt-9">
            <a
              href={referralFormUrl}
              class="inline-flex h-14 items-center justify-center rounded-md bg-secondary px-7 font-bold text-surface transition-opacity hover:opacity-90 sm:min-w-[223px]"
            >
              Online Referral Form
            </a>
            <p class="mt-5 text-base leading-7 text-surface/75">
              Doctors who prefer to call may reach our office at
              <a
                href={OFFICE_PHONE.href}
                class="font-bold text-accent transition-colors hover:text-surface"
              >
                {OFFICE_PHONE.display}
              </a>.
            </p>
          </div>
        </div>

        <div
          class="interior-hero-media relative mx-auto w-full max-w-[500px] lg:mx-0"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          <div
            class="absolute -bottom-3 left-3 right-[-12px] top-3 rounded-lg border border-secondary"
            aria-hidden="true"
          >
          </div>
          <div class="relative aspect-[4/5] overflow-hidden rounded-lg bg-surface/5">
            <Image
              src={interiorHeroImage}
              widths={[600, 900, 1400]}
              sizes="(min-width: 900px) 46vw, 100vw"
              format="webp"
              alt="Dental imaging equipment at Capital Oral Surgery"
              class="h-full w-full object-cover object-center"
              width="5184"
              height="3456"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-background py-20 text-foreground lg:py-24">
      <div class="mx-auto max-w-[920px] px-5">
        <section aria-labelledby="collaboration-heading">
          <div class="max-w-5xl" data-reveal>
            <p class="text-xs font-bold tracking-[.34em] text-secondary">
              Collaborative specialty care
            </p>
            <h2
              id="collaboration-heading"
              class="serif mt-4 text-4xl leading-tight sm:text-5xl"
            >
              A responsive extension of your care team.
            </h2>
            <div class="mt-7 space-y-6 text-base leading-8 text-muted">
              <p>
                Whether your patient needs a planned procedure or prompt evaluation for
                an urgent concern, we work closely with your office to coordinate the
                next step and support continuity of care.
              </p>
              <p>
                We prioritize timely updates so you remain informed about the patient's
                evaluation, treatment plan, and follow-up needs.
              </p>
            </div>

            <div class="mt-8 rounded-lg border border-line bg-surface p-7 shadow-sm sm:p-8">
              <p class="text-xs font-bold tracking-[.28em] text-secondary">
                Security and privacy
              </p>
              <p class="mt-3 text-base leading-7 text-muted">
                Patient data security and privacy are primary concerns. Please use our
                secure online referral form when sharing patient information with the
                practice.
              </p>
            </div>

            <a
              href={referralFormUrl}
              class="mt-8 inline-flex h-14 items-center justify-center rounded-md bg-secondary px-7 font-bold text-surface transition-opacity hover:opacity-90"
            >
              Online Referral Form
            </a>
          </div>
        </section>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
