---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/pr/Hero.astro";
import Section from "../components/pr/Section.astro";
import Photo from "../components/pr/Photo.astro";
import TeamCards from "../components/pr/TeamCards.astro";
import Band from "../components/pr/Band.astro";
import { sitePhotos } from "../data/sitePhotos";
import { breadcrumbSchema } from "../lib/schema";
import { OFFICE_PHONE } from "../lib/site";

const title = "Referring Doctors | Capital Oral Surgery, Topeka, KS";
const description =
  "Refer patients to Capital Oral Surgery and Dental Implants in Topeka, KS for elective oral surgery procedures and emergency care.";
const path = "/refer-a-patient/";
const referralFormUrl = "/refer-a-patient/form/";
const crumbs = [{ name: "Home", href: "/" }, { name: "Patient resources" }, { name: "Referring doctors" }];
const schema = [breadcrumbSchema([{ name: "Home", href: "/" }, { name: "Referring doctors", href: path }])];
---

<Layout title={title} description={description} schema={schema}>
  <Header />
  <main id="main-content" tabindex="-1" class="pr-main">
    <Hero
      crumbs={crumbs}
      eyebrow="For referring offices"
      title="Referring <span>doctors.</span>"
      lede="We welcome referrals from medical and dental colleagues for elective procedures and emergency care. Our team values close collaboration and timely communication with your office throughout each patient's care."
      photo={sitePhotos.coordinator}
      primary={{ label: "Online Referral Form", href: referralFormUrl }}
    >
      <p class="pr-hero-note">Doctors who prefer to call may reach our office at <a href={OFFICE_PHONE.href}>{OFFICE_PHONE.display}</a>.</p>
    </Hero>

    <Section tone="cream" label="Collaborative specialty care" id="collaboration">
      <div class="pr-why">
        <div data-rv>
          <p class="pr-eb">Collaborative specialty care</p>
          <h2 class="pr-h2"><span>A responsive extension</span> of your care team.</h2>
          <p class="pr-p">Whether your patient needs a planned procedure or prompt evaluation for an urgent concern, we work closely with your office to coordinate the next step and support continuity of care.</p>
          <p class="pr-p">We prioritize timely updates so you remain informed about the patient's evaluation, treatment plan, and follow-up needs.</p>
          <div class="pr-note">
            <b>Security and privacy</b>
            <span>Patient data security and privacy are primary concerns. Please use our secure online referral form when sharing patient information with the practice.</span>
          </div>
          <a class="pr-btn g" style="margin-top:28px" href={referralFormUrl}>Online Referral Form</a>
        </div>
        <Photo photo={sitePhotos.exterior} reveal="right" />
      </div>
    </Section>

    <Section tone="sand" label="How referrals work">
      <p class="pr-eb" data-rv>How referrals work</p>
      <h2 class="pr-h2" data-rv><span>Three steps,</span> start to finish.</h2>
      <div class="pr-rows" data-rv>
        <div><h3>Send the referral</h3><p>Use our online referral form, or call our office at {OFFICE_PHONE.display}.</p><small>Step 1</small></div>
        <div><h3>We see your patient</h3><p>For a planned procedure or prompt evaluation for an urgent concern.</p><small>Step 2</small></div>
        <div><h3>You stay informed</h3><p>Timely updates about the patient's evaluation, treatment plan, and follow-up needs.</p><small>Step 3</small></div>
      </div>
    </Section>

    <Section tone="cream" label="Our surgeons">
      <TeamCards eyebrow="Your surgeons" heading="<span>Who will see</span><br>your patient." />
    </Section>

    <Band
      tone="cream"
      eyebrow="For referring offices"
      heading="<span>Refer</span><br>a patient."
      text="Send a referral online or call our office to coordinate care."
      primary={{ label: "Online Referral Form", href: referralFormUrl }}
    />
  </main>
  <SiteFooter />
</Layout>
