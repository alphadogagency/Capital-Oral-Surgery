---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/pr/Hero.astro";
import Section from "../components/pr/Section.astro";
import Photo from "../components/pr/Photo.astro";
import Faq from "../components/pr/Faq.astro";
import TeamCards from "../components/pr/TeamCards.astro";
import Resources from "../components/pr/Resources.astro";
import Band from "../components/pr/Band.astro";
import { sitePhotos } from "../data/sitePhotos";
import { breadcrumbSchema } from "../lib/schema";
import { OFFICE_PHONE } from "../lib/site";

const title = "Your First Visit | Capital Oral Surgery, Topeka, KS";
const description =
  "Prepare for your first visit to our Topeka, KS oral surgery office: what to bring, consultation details, and pre-surgery instructions.";
const path = "/first-visit/";
const crumbs = [{ name: "Home", href: "/" }, { name: "Patient resources" }, { name: "Your first visit" }];

const bring = [
  "Your surgical referral slip and any x-rays if applicable.",
  "A list of medications you are presently taking.",
  "If you have medical or dental insurance, bring the necessary completed forms. This will save time and allow us to help you process any claims.",
];
const rows = [
  ["Under 18", "All patients under the age of 18 must be accompanied by a parent or guardian at the consultation visit."],
  ["IV anesthesia", "A preoperative consultation and physical examination is mandatory for patients undergoing IV anesthesia for surgery. Please have nothing to eat or drink eight hours prior to your surgery. You will also need an adult to drive you home."],
  ["Health conditions and medications", "Please alert the office if you have a medical condition that may be of concern prior to surgery (i.e., diabetes, high blood pressure, artificial heart valves and joints, rheumatic fever, etc.) or if you are currently taking any medications (i.e., heart medications, aspirin, anticoagulant therapy, etc.)."],
  ["X-Rays", "If your dentist or physician has taken x-rays you may request that they forward them to our office. If there is not enough time, please pick them up and bring them to our office. If additional films are necessary they can be taken at our facility."],
];
// Answers restate what this page already says.
const faq = [
  { q: "Can I have surgery on the same day as my consultation?", a: "Occasionally, yes. A complex medical history or treatment plan may require an evaluation and a second appointment to provide treatment on another day." },
  { q: "What should I bring to my first visit?", a: "Your surgical referral slip and any x-rays, a list of the medications you are taking, and completed insurance forms if you have medical or dental insurance." },
  { q: "Do I need someone to drive me home?", a: "If you are having surgery with IV anesthesia, yes. An adult must drive you home, and you should have nothing to eat or drink for eight hours before your surgery." },
  { q: "Can a minor come to the consultation alone?", a: "No. All patients under the age of 18 must be accompanied by a parent or guardian at the consultation visit." },
];
const schema = [breadcrumbSchema([{ name: "Home", href: "/" }, { name: "Your first visit", href: path }])];
---

<Layout title={title} description={description} schema={schema}>
  <Header />
  <main id="main-content" tabindex="-1" class="pr-main">
    <Hero
      crumbs={crumbs}
      eyebrow="Patient resources"
      title="Your first <span>visit.</span>"
      lede="Your initial appointment will consist of a consultation explaining your diagnosis and treatment options."
      photo={sitePhotos.welcome}
    />

    <Section tone="cream" label="Your consultation" id="consultation">
      <div class="pr-why">
        <div data-rv>
          <p class="pr-eb">Your consultation</p>
          <h2 class="pr-h2"><span>What to expect</span> at your first visit.</h2>
          <p class="pr-p">Occasionally, surgery can be performed the same day as the consultation. However, a complex medical history or treatment plan may require an evaluation and a second appointment to provide treatment on another day.</p>
          <p class="pr-cap">What to bring</p>
          <p class="pr-p" style="margin-top:10px;font-size:15px">Please assist us by providing the following information at the time of your consultation:</p>
          <ul class="pr-bring">
            {bring.map((item) => (
              <li><span class="pr-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4 10-10" /></svg></span><span>{item}</span></li>
            ))}
          </ul>
        </div>
        <Photo photo={sitePhotos.checkInDesk} reveal="right" />
      </div>
    </Section>

    <Section tone="sand" label="Before you come in">
      <p class="pr-eb" data-rv>Good to know</p>
      <h2 class="pr-h2" data-rv><span>Before</span> you come in.</h2>
      <div class="pr-rows two" data-rv>
        {rows.map(([label, text]) => <div><h3>{label}</h3><p>{text}</p></div>)}
      </div>
    </Section>

    <Section tone="cream" label="Your care team">
      <TeamCards eyebrow="Surgeons and technology" heading="<span>Your care</span><br>team." />
    </Section>

    <Section tone="sand" label="Frequently asked questions" wrapClass="pr-faqwrap">
      <div data-rv>
        <p class="pr-eb">Patient questions</p>
        <h2 class="pr-h2 sm"><span>Questions patients</span><br />ask most.</h2>
        <p class="pr-p">Call our office at <a href={OFFICE_PHONE.href}>{OFFICE_PHONE.display}</a> if you have a question that is not answered here.</p>
      </div>
      <Faq items={faq} />
    </Section>

    <Resources tone="cream" current={path} photo={sitePhotos.waitingRoom} />

    <Band
      tone="cream"
      eyebrow="Patient resources"
      heading="<span>Schedule a consultation</span><br>today."
      text="Dr. Lucaci, Dr. Barber, Dr. Lonergan & our caring staff want to help take care of your oral surgery needs. Book an appointment today!"
    >
      <p style="margin-top:14px"><a href="/contact-us/#directions" style="color:#fff;text-decoration:underline;text-underline-offset:3px">Map &amp; driving directions</a></p>
    </Band>
  </main>
  <SiteFooter />
</Layout>
