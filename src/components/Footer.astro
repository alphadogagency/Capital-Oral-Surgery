---
import { OFFICE_PHONE } from "../lib/site";
---

<footer class="bg-midnight px-5 py-10 text-surface">
  <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-4 lg:px-8">
    <div class="md:col-span-2">
      <div class="brand-logo-frame">
        <img
          src="/images/logo-light.png"
          alt="Capital Oral Surgery logo"
          class="h-12 w-auto"
          width="1207"
          height="399"
        />
      </div>
      <p class="mt-4 max-w-md text-sm text-surface/70">
        A genuine passion for patient care allows us to provide optimal experiences and
        results every day.
      </p>
    </div>
    <div>
      <h3 class="font-bold text-accent">Office</h3>
      <p class="mt-3 text-sm text-surface/75">
        2445 SW Wanamaker Rd #101<br />Topeka, KS 66614
      </p>
    </div>
    <div>
      <h3 class="font-bold text-accent">Call</h3>
      <p class="mt-3 text-sm text-surface/75">
        <a href={OFFICE_PHONE.href} class="hover:text-aqua-pale">{OFFICE_PHONE.display}</a>
      </p>
    </div>
  </div>
</footer>
