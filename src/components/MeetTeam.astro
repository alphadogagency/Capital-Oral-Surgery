---
import { doctors } from "../data/doctors";
---

<section id="team" class="home-team home-section" aria-labelledby="team-heading">
  <div class="home-shell home-team-grid">
    <div class="home-section-copy" data-reveal>
      <p class="home-eyebrow">Meet the team</p>
      <h2 id="team-heading"><span>Two specialists.</span><br />One trusted practice.</h2>
    </div>
    <div class="home-portraits">
      {doctors.map((doctor, index) => (
        <article data-reveal style={`--reveal-delay: ${index * 90}ms`}>
          <a href={`/doctors/${doctor.slug}/`} class="home-doctor-photo" aria-label={`Meet ${doctor.name}`}>
            <img src={doctor.image} alt={doctor.imageAlt} width={doctor.imageWidth} height={doctor.imageHeight} style={`object-position: ${doctor.imagePosition}`} loading="lazy" decoding="async" />
          </a>
          <h3>{doctor.name}</h3>
          <p class="home-doctor-credentials">{doctor.credentials}</p>
          <p class="home-doctor-role">{doctor.role}</p>
          <a class="home-text-link" href={`/doctors/${doctor.slug}/`} aria-label={`View Bio — ${doctor.name}`}>
            View Bio <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
