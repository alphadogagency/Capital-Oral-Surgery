---
import { Image } from "astro:assets";
import { practicePhotos } from "../data/practicePhotos";
const carePhoto = practicePhotos.preparation;
const checklist = [
  "Two board-trained surgeons under one roof",
  "Sedation options for anxious patients",
  "Trusted by Topeka-area general dentists",
];
---

<section id="about" class="home-care" aria-labelledby="specialized-care-heading">
  <div class="home-care-photo">
    <Image src={carePhoto.src} alt={carePhoto.alt} style={`object-position: ${carePhoto.position}`} widths={[600, 900, 1400]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" />
  </div>
  <div class="home-section-copy home-care-copy" data-reveal>
    <p class="home-eyebrow">A specialist practice</p>
    <h2 id="specialized-care-heading"><span>Specialized care</span> for your most important procedures.</h2>
    <p>
      At Capital Oral Surgery, we focus exclusively on oral and maxillofacial surgery
      — so every patient receives the depth of training and chairside calm that
      complex procedures deserve.
    </p>
    <p>
      Whether you've been referred by your dentist or you're researching options
      yourself, we make sure you feel informed, comfortable, and confident before,
      during, and after care.
    </p>
    <ul class="home-checklist">
      {checklist.map((item) => (<li><span aria-hidden="true">✓</span>{item}</li>))}
    </ul>
  </div>
</section>
