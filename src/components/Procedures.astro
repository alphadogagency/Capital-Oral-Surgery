---
import { Image } from "astro:assets";
import implantRoom from "../assets/homepage/implant-room.webp";
const procedures = [
  {
    number: "01",
    title: "Dental implants",
    body: "Permanent, natural-feeling tooth replacement.",
    href: "/services/replacing-missing-teeth/",
  },
  {
    number: "02",
    title: "Wisdom teeth",
    body: "Gentle removal with sedation options.",
    href: "/services/wisdom-teeth-removal/",
  },
  {
    number: "03",
    title: "Tooth extractions",
    body: "Routine and surgical extractions.",
    href: "/services/tooth-extractions/",
  },
  {
    number: "04",
    title: "Corrective jaw surgery",
    body: "Orthognathic care for function and balance.",
  },
  {
    number: "05",
    title: "Bone grafting",
    body: "Preparing your jaw for implants.",
    href: "/services/bone-grafting/",
  },
  {
    number: "06",
    title: "Oral pathology",
    body: "Diagnosis and treatment of oral lesions.",
    href: "/services/oral-pathology/",
  },
];
---

<section id="procedures" class="home-procedures home-section" aria-labelledby="procedures-heading">
  <div class="home-shell">
    <div class="home-section-copy home-procedures-intro" data-reveal>
      <p class="home-eyebrow">Procedures</p>
      <h2 id="procedures-heading">A complete range<br />of <span>oral surgery</span></h2>
    </div>
    <div class="cap-proc">
      <div class="cap-proc-feat" data-reveal><div class="bg"><Image src={implantRoom} alt="A bright procedure room at Capital Oral Surgery" widths={[600,900,1200]} sizes="(max-width:900px) 100vw, 45vw" loading="lazy" /></div>
        <div><small>Our specialty</small><h3>Dental implants</h3><p>Permanent, natural-feeling tooth replacement.</p></div>
        <div><div class="cap-proc-subs"><a href="/services/single-tooth-implant/">Single tooth</a><a href="/services/full-mouth-dental-implants/">Full-mouth</a><a href="/services/implant-dentures/">Implant dentures</a><a href="/services/bone-grafting-for-implants/">Bone grafting</a></div><a class="cap-proc-explore" href="/services/replacing-missing-teeth/">Explore dental implants →</a></div>
      </div>
      <ul class="cap-proc-list" data-reveal>{procedures.slice(1).map(({title,body,href})=>{const Tag=href?'a':'div';return <li><Tag href={href}><span><h3>{title}</h3><p>{body}</p></span>{href&&<i aria-hidden="true">→</i>}</Tag></li>;})}</ul>
    </div>
    <div class="cap-proc-more"><span><b>Not sure which procedure you need?</b>A referral from your dentist or a quick call to our team is a good place to start.</span><a class="cap-link" href="tel:+17855884244">Call (785) 588-4244</a></div>
  </div>
</section>
