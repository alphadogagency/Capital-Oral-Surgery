---
const procedures = [
  {
    number: "01",
    title: "Dental implants",
    body: "Permanent, natural-feeling tooth replacement.",
    href: "/services/replacing-missing-teeth/",
  },
  {
    number: "02",
    title: "Wisdom teeth",
    body: "Gentle removal with sedation options.",
    href: "/services/wisdom-teeth-removal/",
  },
  {
    number: "03",
    title: "Tooth extractions",
    body: "Routine and surgical extractions.",
    href: "/services/tooth-extractions/",
  },
  {
    number: "04",
    title: "Corrective jaw surgery",
    body: "Orthognathic care for function and balance.",
  },
  {
    number: "05",
    title: "Bone grafting",
    body: "Preparing your jaw for implants.",
    href: "/services/bone-grafting/",
  },
  {
    number: "06",
    title: "Oral pathology",
    body: "Diagnosis and treatment of oral lesions.",
    href: "/services/oral-pathology/",
  },
];
---

<section id="procedures" class="home-procedures home-section" aria-labelledby="procedures-heading">
  <div class="home-shell">
    <div class="home-section-copy home-procedures-intro" data-reveal>
      <p class="home-eyebrow">Procedures</p>
      <h2 id="procedures-heading">A complete range<br />of <span>oral surgery</span></h2>
    </div>
    <div class="home-procedure-grid">
      {procedures.map(({ number, title, body, href }, index) => {
        const Tag = href ? "a" : "div";
        return (
          <article data-reveal style={`--reveal-delay: ${(index % 3) * 80}ms`}>
            <Tag class="home-procedure" href={href}>
              <div class="home-procedure-top">
                <span class="home-procedure-number">{number}</span>
                {href && <span class="home-procedure-arrow" aria-hidden="true">↗</span>}
              </div>
              <h3>{title}</h3>
              <p>{body}</p>
            </Tag>
          </article>
        );
      })}
    </div>
  </div>
</section>
