---
interface Props {
  name: string;
  label: string;
  options?: string[];
  id?: string;
  variant?: "segmented" | "wrap";
}

const {
  name,
  label,
  options = ["Yes", "No"],
  id = name,
  variant = "segmented",
} = Astro.props;

const optionLayout =
  variant === "wrap"
    ? "grid gap-2 sm:grid-cols-2 lg:grid-cols-3"
    : "grid grid-cols-2 gap-2";
---

<fieldset class="grid gap-3">
  <legend class="text-sm font-bold leading-6 text-foreground">{label}</legend>
  <div class={optionLayout}>
    {
      options.map((option, index) => {
        const optionId = `${id}-${index}`;

        return (
          <label class="relative cursor-pointer">
            <input
              id={optionId}
              class="peer sr-only"
              type="radio"
              name={name}
              value={option}
            />
            <span class="flex min-h-11 items-center justify-center rounded-md border border-line bg-surface px-3 text-center text-sm font-bold text-muted transition-colors hover:border-secondary hover:text-foreground peer-checked:border-secondary peer-checked:bg-secondary peer-checked:text-surface peer-focus-visible:ring-2 peer-focus-visible:ring-secondary peer-focus-visible:ring-offset-2">
              {option}
            </span>
          </label>
        );
      })
    }
  </div>
</fieldset>
