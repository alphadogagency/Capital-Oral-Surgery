---
interface Props {
  id: string;
  title: string;
  upper: string[];
  lower: string[];
  minWidth: string;
}

const { id, title, upper, lower, minWidth } = Astro.props;
const columnStyle = `grid-template-columns: repeat(${upper.length}, minmax(2.25rem, 1fr));`;
---

<div class="grid gap-4" role="group" aria-labelledby={`${id}-heading`}>
  <p id={`${id}-heading`} class="text-sm font-bold text-foreground">{title}</p>
  <div class="overflow-x-auto pb-2">
    <div class="flex items-center gap-3" style={`min-width: ${minWidth};`}>
      <span class="w-12 shrink-0 text-center text-[11px] font-bold tracking-[.18em] text-muted">
        RIGHT
      </span>
      <div class="grid min-w-0 flex-1 gap-2">
        <div class="grid gap-1.5" style={columnStyle}>
          {
            upper.map((tooth) => (
              <label class="relative cursor-pointer" title={`${title}: tooth ${tooth}`}>
                <input
                  class="peer sr-only"
                  type="checkbox"
                  name="selectedTeeth"
                  value={tooth}
                  data-tooth-toggle
                />
                <span class="flex h-11 items-center justify-center rounded-t-md rounded-b-[45%] border border-line bg-surface text-sm font-bold text-foreground transition-colors hover:border-secondary peer-checked:border-secondary peer-checked:bg-secondary peer-checked:text-surface peer-focus-visible:ring-2 peer-focus-visible:ring-secondary peer-focus-visible:ring-offset-2">
                  <span class="sr-only">{title}: tooth </span>{tooth}
                </span>
              </label>
            ))
          }
        </div>
        <div class="grid gap-1.5" style={columnStyle}>
          {
            lower.map((tooth) => (
              <label class="relative cursor-pointer" title={`${title}: tooth ${tooth}`}>
                <input
                  class="peer sr-only"
                  type="checkbox"
                  name="selectedTeeth"
                  value={tooth}
                  data-tooth-toggle
                />
                <span class="flex h-11 items-center justify-center rounded-t-[45%] rounded-b-md border border-line bg-surface text-sm font-bold text-foreground transition-colors hover:border-secondary peer-checked:border-secondary peer-checked:bg-secondary peer-checked:text-surface peer-focus-visible:ring-2 peer-focus-visible:ring-secondary peer-focus-visible:ring-offset-2">
                  <span class="sr-only">{title}: tooth </span>{tooth}
                </span>
              </label>
            ))
          }
        </div>
      </div>
      <span class="w-12 shrink-0 text-center text-[11px] font-bold tracking-[.18em] text-muted">
        LEFT
      </span>
    </div>
  </div>
</div>
