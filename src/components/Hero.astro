---
import { Image } from "astro:assets";
import heroPhoto from "../../public/images/hero.jpg";
import { OFFICE_PHONE } from "../lib/site";
---

<section class="home-hero" aria-labelledby="hero-heading">
  <div class="home-hero-media">
    <Image src={heroPhoto} alt="Capital Oral Surgery consultation room" widths={[750, 1200, 1800, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="home-hero-shade" aria-hidden="true"></div>
  <div class="home-shell home-hero-content">
    <div class="home-hero-copy">
      <p class="home-hero-location">Topeka • Oral &amp; maxillofacial surgery</p>
      <h1 id="hero-heading">Surgical expertise,<br /><strong>delivered with calm.</strong></h1>
      <p class="home-hero-description">
        From wisdom teeth to dental implants and corrective jaw surgery, our
        two specialists guide you through every step with clarity and care.
      </p>
    </div>
    <div class="home-actions">
      <a href="#appointment" class="home-button home-button-cyan">Request Appointment <span aria-hidden="true">→</span></a>
      <a href={OFFICE_PHONE.href} class="home-button home-button-light-outline">Call {OFFICE_PHONE.display} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<div class="home-trust-band">
  <div class="home-shell home-trust-grid">
    <div class="home-stat"><strong>2</strong><p>Board-certified surgeons</p></div>
    <div class="home-stat"><strong>20+</strong><p>Years serving Topeka</p></div>
    <figure class="home-review-note">
      <span class="home-stars" aria-label="5 star review">★★★★★</span>
      <blockquote>“Calm, clear, and genuinely kind from start to finish.”</blockquote>
      <figcaption>Topeka patient <span aria-hidden="true">·</span> Google review</figcaption>
    </figure>
  </div>
</div>
