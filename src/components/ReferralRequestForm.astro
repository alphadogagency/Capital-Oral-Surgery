---
import { OFFICE_PHONE } from "../lib/site";

// Professional referral form (separate from the appointment form). Notifications route to
// Bryan during review; practice routing is managed in Jotform, not this page.
const formUrl = "https://form.jotform.com/263225676588067";
---

<div class="appointment-request">
  <iframe
    id="JotFormIFrame-263225676588067"
    title="Capital Oral Surgery patient referral form"
    src={formUrl}
    loading="lazy"
    height="4200"
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
  <p class="request-fallback">
    <a href={formUrl} target="_blank" rel="noopener noreferrer">Open the referral form in a new tab</a>
    <span aria-hidden="true"> · </span>
    <a href={OFFICE_PHONE.href}>Call {OFFICE_PHONE.display}</a>
  </p>
</div>

<script is:inline src="https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js"></script>
<script is:inline>
  if (typeof window.jotformEmbedHandler === "function") {
    window.jotformEmbedHandler(
      "iframe[id='JotFormIFrame-263225676588067']",
      "https://form.jotform.com/",
    );
    // Jotform shrinks the iframe for its confirmation page. Keep that result
    // visible for someone who submitted from the bottom of the long form.
    const frame = document.getElementById("JotFormIFrame-263225676588067");
    if (frame && "ResizeObserver" in window) {
      let previousHeight = frame.getBoundingClientRect().height;
      new ResizeObserver(() => {
        const height = frame.getBoundingClientRect().height;
        if (height < previousHeight / 2 && document.activeElement === frame) {
          frame.scrollIntoView({ block: "start", behavior: "instant" });
        }
        previousHeight = height;
      }).observe(frame);
    }
  }
</script>

<style>
  .appointment-request { min-width: 0; width: 100%; }
  iframe { display: block; width: 100%; max-width: 100%; border: 0; border-radius: 24px; scroll-margin-top: 120px; }
  .request-fallback { margin: 16px 0 0; text-align: center; font-size: 14px; line-height: 1.7; }
  .request-fallback a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .request-fallback a:focus-visible { outline: 3px solid #3e5a40; outline-offset: 4px; border-radius: 2px; }
</style>
