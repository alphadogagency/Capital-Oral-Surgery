---
import { OFFICE_PHONE } from "../lib/site";
---

<section
  id="appointment"
  class="home-appointment home-section"
  aria-labelledby="appointment-heading"
>
  <div
    class="home-shell home-appointment-grid"
  >
    <div class="home-section-copy" data-reveal>
      <p class="home-eyebrow">
        Request appointment
      </p>
      <h2
        id="appointment-heading"
      >
        Let's get you<br /><span>scheduled.</span>
      </h2>
      <p class="mt-6 max-w-[540px] text-base leading-7 text-muted">
        Call our team to schedule your appointment and find a time that works for you.
      </p>

      <dl class="mt-9 space-y-4 text-sm text-foreground">
        <div>
          <dt class="inline font-bold">Address</dt>
          <dd class="inline"> 2445 SW Wanamaker Rd, Suite 101<br />Topeka, KS 66614</dd>
        </div>
        <div>
          <dt class="inline font-bold">Phone</dt>
          <dd class="inline"> <a href="tel:+17855884244">{OFFICE_PHONE.display}</a></dd>
        </div>
        <div>
          <dt class="inline font-bold">Hours</dt>
          <dd class="inline"> Mon-Fri, 8am-5pm</dd>
        </div>
      </dl>
    </div>

    <div class="home-schedule-card" data-reveal>
      <p class="home-eyebrow">Let’s talk</p>
      <h3>Schedule your visit.</h3>
      <p>Our team is here to help you take the next step.</p>
      <a class="cap-btn green home-schedule-call" href="tel:+17855884244">
        Call to Schedule <span aria-hidden="true">↗</span>
      </a>
      <p class="home-schedule-number">{OFFICE_PHONE.display}</p>
    </div>
  </div>
</section>
